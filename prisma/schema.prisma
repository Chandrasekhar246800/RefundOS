datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  category    String
  currency    String    @default("USD")
  status      String    @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  orders      Order[]
  batches     ProcessingBatch[]
}

model Product {
  id             String          @id @default(cuid())
  brandId        String
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name           String
  sku            String          @unique
  category       String
  description    String?
  unitPrice      Int             // Stored in minor units (e.g. cents)
  currency       String          @default("USD")
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orders         Order[]
  refundRequests RefundRequest[]
  batches        ProcessingBatch[]
  riskProfile    ProductRiskProfile?
}

model Customer {
  id                    String          @id @default(cuid())
  syntheticCustomerRef  String          @unique
  accountCreatedAt      DateTime
  totalOrders           Int             @default(1)
  priorRefundCount      Int             @default(0)
  priorReturnCount      Int             @default(0)
  priorChargebackCount  Int             @default(0)
  createdAt             DateTime        @default(now())

  orders                Order[]
  refundRequests        RefundRequest[]
  riskProfile           CustomerRiskProfile?
}

model Order {
  id               String          @id @default(cuid())
  orderRef         String          @unique
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brandId          String
  brand            Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int             @default(1)
  amount           Int             // in minor units (cents)
  currency         String          @default("USD")
  purchasedAt      DateTime
  deliveredAt      DateTime?
  fulfilmentStatus String          // DELIVERED, IN_TRANSIT, CANCELLED, PENDING
  deliveryEvidence String?         // JSON string with carrier, tracking, delivery confirmation details
  createdAt        DateTime        @default(now())

  refundRequests       RefundRequest[]
  deliveryIntelligence DeliveryIntelligence?
}

model RefundRequest {
  id               String              @id @default(cuid())
  requestRef       String              @unique
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason           String              // DAMAGED_ITEM, WRONG_ITEM, NOT_RECEIVED, DUPLICATE_CHARGE, DEFECTIVE, CHANGED_MIND, FRAUDULENT_CLAIM
  customerMessage  String?
  requestedAmount  Int                 // in minor units (cents)
  currency         String              @default("USD")
  requestedAt      DateTime            @default(now())
  evidence         String?             // JSON string describing submitted proof/metadata
  groundTruthLabel String              // LEGITIMATE | NON_LEGITIMATE (kept separate from AI inputs)
  status           String              @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED, MANUAL_REVIEW, FAILED
  batchId          String?
  batch            ProcessingBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  decision         Decision?
  transaction      RefundTransaction?
  layaUsage        LayaUsageLog[]
  evidenceFiles    EvidenceFile[]
  fraudEvaluation  FraudEvaluation?
  investigationCase InvestigationCase?
}

model Decision {
  id                       String        @id @default(cuid())
  refundRequestId          String        @unique
  refundRequest            RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  provider                 String        // JEV | LOCAL_DEMO
  modelOrDeployment        String?
  policyVersion            String
  decision                 String        // APPROVE | REJECT | MANUAL_REVIEW
  riskScore                Int?          // 0 - 100
  confidence               Float?        // 0.0 - 1.0
  reasonCodes              String        // JSON array of strings
  rationale                String
  evidenceFor              String        // JSON array of strings
  evidenceAgainst          String        // JSON array of strings
  missingInformation       String        // JSON array of strings
  policyChecks             String        // JSON array of objects { rule, result, explanation }
  recommendedNextAction    String?
  inputSnapshot            String        // JSON string of input evidence packet (WITHOUT ground truth)
  providerResponseSanitized String       // JSON string of raw provider response (redacted secrets)
  createdAt                DateTime      @default(now())
}

model RefundTransaction {
  id              String        @id @default(cuid())
  refundRequestId String        @unique
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  amount          Int           // minor units
  currency        String        @default("USD")
  status          String        @default("SIMULATED_COMPLETED")
  reference       String        @unique // e.g. SIM-TXN-XXXX
  createdAt       DateTime      @default(now())
}

model ProcessingBatch {
  id                String          @id @default(cuid())
  brandId           String
  brand             Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  status            String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalCount        Int             @default(0)
  processedCount    Int             @default(0)
  approvedCount     Int             @default(0)
  rejectedCount     Int             @default(0)
  manualReviewCount Int             @default(0)
  failedCount       Int             @default(0)
  provider          String          @default("LOCAL_DEMO")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())

  requests          RefundRequest[]
  layaUsage         LayaUsageLog[]
}

model LayaUsageLog {
  id               String           @id @default(cuid())
  refundRequestId  String?
  refundRequest    RefundRequest?   @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)
  batchId          String?
  batch            ProcessingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  endpoint         String           @default("/v1/systemone")
  model            String           @default("typed-decisions")
  inputTokens      Int              @default(0)
  stateTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  totalTokens      Int              @default(0)
  latencyMs        Int              @default(0)
  estimatedCostUsd Float?           // e.g. based on token pricing ($0.042 / 1M input tokens)
  statusCode       Int              @default(200)
  createdAt        DateTime         @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String   // BRAND, PRODUCT, REFUND_REQUEST, BATCH, DECISION, SETTING, DEMO
  entityId   String
  eventType  String   // CREATED, UPDATED, GENERATED, PROCESSING_STARTED, PROCESSED, DECIDED, TRANSACTION_CREATED, RETRIED, RESET
  actor      String   @default("demo_operator")
  details    String?  // JSON string
  createdAt  DateTime @default(now())
}

model RefundPolicy {
  id            String   @id @default(cuid())
  version       String   @unique
  name          String
  configuration String   // JSON string of rules & thresholds
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String   // JSON string or string
  updatedAt DateTime @updatedAt
}

// ==========================================
// REFUND OS 2.0 EXTENSIONS
// ==========================================

model EvidenceFile {
  id              String             @id @default(cuid())
  refundRequestId String
  refundRequest   RefundRequest      @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  fileType        String             // IMAGE, DOCUMENT
  fileName        String
  filePath        String             // Relative path in storage
  fileSize        Int                // in bytes
  mimeType        String
  fileHash        String             // SHA-256 for duplicate and tamper detection
  perceptualHash  String?            // 64-bit dHash for visual similarity / near-duplicate detection
  uploadedAt      DateTime           @default(now())

  imageAnalysis    ImageAnalysis?
  documentAnalysis DocumentAnalysis?
}

model ImageAnalysis {
  id                 String       @id @default(cuid())
  evidenceFileId     String       @unique
  evidenceFile       EvidenceFile @relation(fields: [evidenceFileId], references: [id], onDelete: Cascade)
  width              Int?
  height             Int?
  format             String?
  qualityScore       Int?         // 0 - 100 sharpness & clarity
  isBlurry           Boolean      @default(false)
  lightingIssue      Boolean      @default(false)
  damageDetected     Boolean      @default(false)
  damageType         String?      // CRACKED, WATER_DAMAGE, TORN, DEFECTIVE, WRONG_ITEM, DENTED, SCRATCHED
  damageSeverity     String       @default("NONE") // NONE, LOW, MEDIUM, HIGH, SEVERE
  packagingCondition String       @default("UNOPENED") // UNOPENED, OPENED_INTACT, DAMAGED_TAMPERED
  tamperScore        Int          @default(0) // 0 - 100
  exifTimestamp      DateTime?
  exifDeviceModel    String?
  authenticityScore  Int          @default(100) // 0 - 100
  analysisSummary    String
  provider           String       @default("LOCAL_CV") // LOCAL_CV, LAYA_VISION, EXTERNAL_VISION
  modelOrEngine      String       @default("sharp-cv-v1")
  createdAt          DateTime     @default(now())
}

model DocumentAnalysis {
  id                     String       @id @default(cuid())
  evidenceFileId         String       @unique
  evidenceFile           EvidenceFile @relation(fields: [evidenceFileId], references: [id], onDelete: Cascade)
  documentType           String       // INVOICE, PACKING_SLIP, RETURN_LABEL, CARRIER_LOG, POLICE_REPORT, AFFIDAVIT
  ocrText                String       // Full extracted text
  extractedOrderId       String?
  extractedInvoiceNo     String?
  extractedTracking      String?
  extractedAmount        Int?         // in minor units
  extractedTaxAmount     Int?
  extractedDate          DateTime?
  extractedProductName   String?
  extractedSku           String?
  extractedCarrier       String?
  extractedDeliveryDate  DateTime?
  extractedCustomerRef   String?
  orderMatchStatus       String       @default("MATCHED") // MATCHED, PARTIAL_MISMATCH, CONTRADICTORY
  confidenceScore        Float        @default(1.0)
  inconsistencies        String?      // JSON array of detected discrepancies
  provider               String       @default("TESSERACT_OCR") // TESSERACT_OCR, PDF_PARSE, EXTERNAL_OCR
  createdAt              DateTime     @default(now())
}

model DeliveryIntelligence {
  id                     String        @id @default(cuid())
  orderId                String        @unique
  order                  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier                String
  trackingNumber         String
  carrierStatus          String
  geofenceMatch          Boolean       @default(true) // GPS scan within 50m of delivery address
  geofenceDistanceMeters Float?
  transitVelocityValid   Boolean       @default(true) // Detects physically impossible delivery hops
  signatureVerified      Boolean       @default(false)
  deliveryPhotoVerified  Boolean       @default(false)
  carrierDisputeFlag     Boolean       @default(false)
  riskScore              Int           @default(0) // 0 - 100
  signalsJson            String        // Serialized carrier event timeline
  updatedAt              DateTime      @updatedAt
}

model CustomerRiskProfile {
  id                    String        @id @default(cuid())
  customerId            String        @unique
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  compositeRiskScore    Int           @default(15) // 0 - 100
  riskTier              String        @default("LOW") // LOW, MEDIUM, HIGH, RESTRICTED
  claimsLast7Days       Int           @default(0)
  claimsLast30Days      Int           @default(0)
  refundToSpendRatio    Float         @default(0.0) // Refund amount / Lifetime spend
  chargebackRate        Float         @default(0.0)
  anonymizedClusterHash String?       // Anonymized identifier for address/account link analysis
  fraudSignals          String        // JSON array of active risk flags
  lastEvaluatedAt       DateTime      @default(now())
}

model FraudEvaluation {
  id                  String        @id @default(cuid())
  refundRequestId     String        @unique
  refundRequest       RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  fraudScore          Int           @default(0) // 0 - 100
  riskTier            String        @default("LOW") // LOW, MODERATE, HIGH, CRITICAL
  detectedPatterns    String        // JSON array of detected fraud patterns
  anomalyDetails      String        // JSON details of signals triggering risk
  dispositionProposal String        @default("PASS") // PASS, REVIEW, REJECT
  createdAt           DateTime      @default(now())
}

model ProductRiskProfile {
  id                  String        @id @default(cuid())
  productId           String        @unique
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  claimRate           Float         @default(0.0) // Claims / Total sales
  defectClaimRate     Float         @default(0.0)
  fraudIncidenceRate  Float         @default(0.0)
  highShrinkCategory  Boolean       @default(false)
  riskTier            String        @default("STANDARD") // STANDARD, WATCHLIST, HIGH_RISK
  clusterAnalysisJson String?       // JSON: Top reported defects & component failure patterns
  updatedAt           DateTime      @updatedAt
}

model InvestigationCase {
  id                 String             @id @default(cuid())
  refundRequestId    String             @unique
  refundRequest      RefundRequest      @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  assignedTo         String?            // Analyst username/ID
  priority           String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status             String             @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, ESCALATED
  investigationNotes InvestigationNote[]
  resolutionAudit    ManualOverrideAudit?
  openedAt           DateTime           @default(now())
  resolvedAt         DateTime?
}

model InvestigationNote {
  id        String            @id @default(cuid())
  caseId    String
  case      InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    String            @default("analyst")
  noteText  String
  tag       String?           // EVIDENCE_CHECK, CUSTOMER_CALL, CARRIER_DISPUTE, SUPERVISOR_NOTE
  createdAt DateTime          @default(now())
}

model ManualOverrideAudit {
  id                 String            @id @default(cuid())
  caseId             String            @unique
  case               InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  originalAiDecision String            // APPROVE | REJECT | MANUAL_REVIEW
  overrideDecision   String            // APPROVE | REJECT
  operatorName       String
  justification      String            // Mandatory business reason
  policyException    Boolean           @default(false)
  timestamp          DateTime          @default(now())
}
