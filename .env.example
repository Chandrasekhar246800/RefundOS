# Environment Variables Configuration
# Do not store real production credentials in this file.

DATABASE_URL="file:./dev.db"

# Primary AI Decision Provider (Laya API System One)
# Official endpoint: https://api.laya-ai.com
# Documentation: https://laya-ai.com/laya-api
LAYA_API_BASE_URL="https://api.laya-ai.com"
LAYA_API_KEY="your-laya-api-key-here"
LAYA_MODEL="typed-decisions"

# Active Decision Provider: "LAYA" (default primary) or "LOCAL_DEMO" (deterministic fallback)
DEFAULT_DECISION_PROVIDER="LAYA"
