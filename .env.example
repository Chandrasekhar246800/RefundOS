# Environment Variables Configuration
# Do not store real production credentials in this file.

DATABASE_URL="file:./dev.db"

# Jev Decision API Configuration (TypeSafe AI System One)
# Official endpoint: https://api.typesafe.ai/v1
# Obtain your API key from TypeSafe AI (e.g. jv_live_...)
JEV_API_BASE_URL="https://api.typesafe.ai/v1"
JEV_API_KEY="your-jev-api-key-here"
JEV_MODEL="jev-latest"

# Active Decision Provider: "LOCAL_DEMO" (default fallback) or "JEV"
DEFAULT_DECISION_PROVIDER="LOCAL_DEMO"
